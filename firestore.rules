rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil pelo nickname: permite entrar em outro aparelho apenas com o nick.
    // Observação: nickname não é uma autenticação forte; quem souber o nick
    // consegue acessar esse perfil.
    match /mathQuestProfiles/{profileId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Ranking também usa o nickname como identificador do aluno.
    match /mathQuestRanking/{grade}/players/{playerId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.grade == grade;
      allow delete: if false;
    }
  }
}
